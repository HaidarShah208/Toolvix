# Canonical production origin, no trailing slash. Used for canonical URLs,
# Open Graph, JSON-LD, sitemap.xml and robots.txt. REQUIRED in production.
NEXT_PUBLIC_SITE_URL=https://www.toolvix.store

# Set to "false" on preview/staging deployments to serve a blocking robots.txt.
NEXT_PUBLIC_ALLOW_INDEXING=true

# Public contact address shown on /contact and in Organization schema.
# Defaults to hello@<your domain> when unset.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional X/Twitter handle for twitter:site, e.g. @Toolvix
NEXT_PUBLIC_TWITTER_HANDLE=

# Search engine verification (meta tags). Leave blank if you verify via DNS.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Analytics: Google Analytics 4 measurement ID (G-XXXXXXX). Nothing loads when blank.
NEXT_PUBLIC_GA_ID=

# AdSense: publisher ID (ca-pub-XXXXXXXXXXXXXXXX) and slot IDs per placement.
# Ad slots render nothing until both the client and the slot ID are set.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_AD_SLOT_BELOW_TOOL=
NEXT_PUBLIC_AD_SLOT_IN_CONTENT=
NEXT_PUBLIC_AD_SLOT_SIDEBAR=

